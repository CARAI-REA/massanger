# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# ROOMS СЕРВИС
# -----------------------------------------
#
#
# gRPC сервер
ROOMS_GRPC_HOST=localhost
ROOMS_GRPC_PORT=8080
ROOMS_GRPC_READ_TIMEOUT=5s
ROOMS_METRICS_HOST=0.0.0.0
ROOMS_METRICS_PORT=9090

# Логгер
ROOMS_LOGGER_LEVEL=info
ROOMS_LOGGER_AS_JSON=true

# PostgreSQL
ROOMS_POSTGRES_HOST=localhost
ROOMS_POSTGRES_PORT=5432
ROOMS_EXTERNAL_POSTGRES_PORT=5432
ROOMS_POSTGRES_USER=rooms_user
ROOMS_POSTGRES_PASSWORD=rooms_password
ROOMS_POSTGRES_DB=rooms
ROOMS_POSTGRES_SSL_MODE=disable
ROOMS_MIGRATION_DIRECTORY=./internal/migrations

# -----------------------------------------
# CORE (Kafka и общая инфраструктура, deploy/compose/core)
# -----------------------------------------
# Порты брокера: внутри сети Docker / с хоста / KRaft controller
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# Bootstrap для клиентов с хоста (Sarama и т.д.), см. room_task.md
CORE_KAFKA_BROKERS=localhost:${CORE_KAFKA_EXTERNAL_PORT}

# -----------------------------------------
# ROOMS — Kafka (синхронная публикация событий, room_task.md §7.4)
# -----------------------------------------
ROOMS_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
ROOMS_KAFKA_ROOM_EVENTS_TOPIC=room-events
ROOMS_KAFKA_PARTICIPANT_EVENTS_TOPIC=participant-events

# -----------------------------------------
# CORE — Redis (deploy/compose/core)
# -----------------------------------------
CORE_REDIS_EXTERNAL_PORT=6379

# -----------------------------------------
# ROOMS — Redis (клиент redigo pool, clean_arch)
# -----------------------------------------
ROOMS_REDIS_HOST=localhost
ROOMS_REDIS_PORT=6379
ROOMS_REDIS_PASSWORD=
ROOMS_REDIS_CONNECTION_TIMEOUT=3s
ROOMS_REDIS_MAX_IDLE=10
ROOMS_REDIS_IDLE_TIMEOUT=2m
ROOMS_REDIS_CACHE_TTL=1h

# JWT (auth от API Gateway + join-token для Signaling) — в prod замените на CHANGE_ME / Vault
ROOMS_APP_ENV=development
ROOMS_JWT_SECRET=rooms-auth-secret
ROOMS_JOIN_TOKEN_SECRET_KEY=rooms-join-token-secret
ROOMS_JOIN_TOKEN_EXPIRATION=5m
ROOMS_SERVICE_JWT_SECRET=rooms-service-jwt-secret
ROOMS_GRPC_MAX_RPS=0
ROOMS_TURN_SHARED_SECRET=sfu-turn-secret
ROOMS_TURN_URLS=turn:localhost:3478?transport=udp
ROOMS_TURN_TTL=1h

# -----------------------------------------
# SIGNALING СЕРВИС
# -----------------------------------------
SIGNALING_HTTP_HOST=0.0.0.0
SIGNALING_HTTP_PORT=8081
SIGNALING_WS_PATH=/v1/ws
SIGNALING_WS_PING_INTERVAL=20s
SIGNALING_WS_PONG_WAIT=30s
SIGNALING_WS_MAX_MESSAGE_BYTES=65536
SIGNALING_WS_MAX_MESSAGES_PER_SEC=50
SIGNALING_WS_ALLOWED_ORIGINS=
SIGNALING_WS_ALLOW_QUERY_TOKEN=true
# production: WS_ALLOW_QUERY_TOKEN must be false
SIGNALING_APP_ENV=development

SIGNALING_METRICS_HOST=0.0.0.0
SIGNALING_METRICS_PORT=9091

SIGNALING_LOGGER_LEVEL=info
SIGNALING_LOGGER_AS_JSON=true

SIGNALING_REDIS_HOST=localhost
SIGNALING_REDIS_PORT=6379
SIGNALING_REDIS_PASSWORD=
SIGNALING_REDIS_CONNECTION_TIMEOUT=3s
SIGNALING_REDIS_MAX_IDLE=10
SIGNALING_REDIS_IDLE_TIMEOUT=2m
SIGNALING_PRESENCE_TTL=30s

SIGNALING_JOIN_TOKEN_SECRET_KEY=${ROOMS_JOIN_TOKEN_SECRET_KEY}
SIGNALING_SERVICE_JWT_SECRET=${ROOMS_SERVICE_JWT_SECRET}
SIGNALING_SERVICE_NAME=signaling

SIGNALING_ROOM_GRPC_ADDR=localhost:8080
SIGNALING_ROOM_GRPC_ENABLED=true

SIGNALING_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
SIGNALING_KAFKA_ROOM_EVENTS_TOPIC=room-events
SIGNALING_KAFKA_PARTICIPANT_EVENTS_TOPIC=participant-events
SIGNALING_KAFKA_CONSUMER_GROUP=signaling
SIGNALING_KAFKA_CONSUMER_ENABLED=true

SIGNALING_INSTANCE_ID=signaling-1

SIGNALING_SFU_ENABLED=true
SIGNALING_SFU_PUBLIC_URL=ws://localhost:8082/v1/ws

# -----------------------------------------
# SFU СЕРВИС
# -----------------------------------------
SFU_HTTP_HOST=0.0.0.0
SFU_HTTP_PORT=8082
SFU_WS_PATH=/v1/ws
SFU_WS_PING_INTERVAL=20s
SFU_WS_PONG_WAIT=30s
SFU_WS_MAX_MESSAGE_BYTES=65536
SFU_WS_MAX_MESSAGES_PER_SEC=50
SFU_WS_ALLOWED_ORIGINS=
SFU_WS_ALLOW_QUERY_TOKEN=true
# production: WS_ALLOW_QUERY_TOKEN must be false
SFU_APP_ENV=development

SFU_METRICS_HOST=0.0.0.0
SFU_METRICS_PORT=9093

SFU_LOGGER_LEVEL=info
SFU_LOGGER_AS_JSON=true

SFU_REDIS_HOST=localhost
SFU_REDIS_PORT=6379
SFU_REDIS_PASSWORD=
SFU_REDIS_CONNECTION_TIMEOUT=3s
SFU_REDIS_MAX_IDLE=10
SFU_REDIS_IDLE_TIMEOUT=2m
SFU_AFFINITY_TTL=30s

SFU_JOIN_TOKEN_SECRET_KEY=${ROOMS_JOIN_TOKEN_SECRET_KEY}
SFU_SERVICE_JWT_SECRET=${ROOMS_SERVICE_JWT_SECRET}
SFU_SERVICE_NAME=sfu

SFU_ROOM_GRPC_ADDR=localhost:8080
SFU_ROOM_GRPC_ENABLED=true

SFU_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
SFU_KAFKA_ROOM_EVENTS_TOPIC=room-events
SFU_KAFKA_PARTICIPANT_EVENTS_TOPIC=participant-events
SFU_KAFKA_CONSUMER_GROUP=sfu
SFU_KAFKA_CONSUMER_ENABLED=true

SFU_INSTANCE_ID=sfu-1
SFU_PUBLIC_WS_URL=ws://localhost:8082/v1/ws

SFU_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,turn:localhost:3478?transport=udp
SFU_WEBRTC_CLIENT_ICE_SERVERS=stun:stun.l.google.com:19302,turn:localhost:3478?transport=udp
SFU_WEBRTC_TURN_USERNAME=sfu
SFU_WEBRTC_TURN_CREDENTIAL=sfu-turn-secret
SFU_WEBRTC_UDP_PORT_MIN=10000
SFU_WEBRTC_UDP_PORT_MAX=10100
SFU_WEBRTC_NAT_1TO1_IPS=
SFU_WEBRTC_NAT_1TO1_CANDIDATE_TYPE=host
SFU_WEBRTC_SIMULCAST_ENABLED=false
SFU_WEBRTC_RECORDING_ENABLED=false
SFU_WEBRTC_RECORDING_DIR=/tmp/sfu-recordings

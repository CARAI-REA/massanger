# ----------------------------
# Настройки gRPC-сервера
# ----------------------------

# Адрес, на котором будет слушать gRPC-сервер
GRPC_HOST=${ROOMS_GRPC_HOST}

# Порт, на котором будет работать gRPC-сервер
GRPC_PORT=${ROOMS_GRPC_PORT}

# ----------------------------
# Метрики Prometheus
# ----------------------------
METRICS_HOST=${ROOMS_METRICS_HOST}
METRICS_PORT=${ROOMS_METRICS_PORT}

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${ROOMS_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${ROOMS_LOGGER_AS_JSON}


# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Хост PostgreSQL-сервера (для внутренних подключений)
POSTGRES_HOST=${ROOMS_POSTGRES_HOST}

# Внутренний порт PostgreSQL
POSTGRES_PORT=${ROOMS_POSTGRES_PORT}

# Внешний порт PostgreSQL (для подключения извне контейнера)
EXTERNAL_POSTGRES_PORT=${ROOMS_EXTERNAL_POSTGRES_PORT}

# Имя пользователя для подключения к PostgreSQL
POSTGRES_USER=${ROOMS_POSTGRES_USER}

# Пароль пользователя для подключения к PostgreSQL
POSTGRES_PASSWORD=${ROOMS_POSTGRES_PASSWORD}

# Название базы данных
POSTGRES_DB=${ROOMS_POSTGRES_DB}

# Режим подключения по SSL (например, disable, require)
POSTGRES_SSL_MODE=${ROOMS_POSTGRES_SSL_MODE}

# Путь к директории с миграциями
MIGRATION_DIRECTORY=${ROOMS_MIGRATION_DIRECTORY}

# ----------------------------
# Kafka (события комнат и участников)
# ----------------------------
KAFKA_BROKERS=${ROOMS_KAFKA_BROKERS}
ROOM_EVENTS_TOPIC=${ROOMS_KAFKA_ROOM_EVENTS_TOPIC}
PARTICIPANT_EVENTS_TOPIC=${ROOMS_KAFKA_PARTICIPANT_EVENTS_TOPIC}

# ----------------------------
# Redis (как в space_manufacture/redis/clean_arch)
# ----------------------------
REDIS_HOST=${ROOMS_REDIS_HOST}
REDIS_PORT=${ROOMS_REDIS_PORT}
REDIS_CONNECTION_TIMEOUT=${ROOMS_REDIS_CONNECTION_TIMEOUT}
REDIS_MAX_IDLE=${ROOMS_REDIS_MAX_IDLE}
REDIS_IDLE_TIMEOUT=${ROOMS_REDIS_IDLE_TIMEOUT}
REDIS_CACHE_TTL=${ROOMS_REDIS_CACHE_TTL}

# ----------------------------
# JWT (auth от API Gateway + join-token для Signaling)
# ----------------------------
JWT_SECRET=${ROOMS_JWT_SECRET}
JOIN_TOKEN_SECRET_KEY=${ROOMS_JOIN_TOKEN_SECRET_KEY}
JOIN_TOKEN_EXPIRATION=${ROOMS_JOIN_TOKEN_EXPIRATION}
SERVICE_JWT_SECRET=${ROOMS_SERVICE_JWT_SECRET}

# ----------------------------
# Production readiness
# ----------------------------
APP_ENV=${ROOMS_APP_ENV}
GRPC_MAX_RPS=${ROOMS_GRPC_MAX_RPS}
REDIS_PASSWORD=${ROOMS_REDIS_PASSWORD}

# TURN (ephemeral credentials for clients)
TURN_SHARED_SECRET=${ROOMS_TURN_SHARED_SECRET}
TURN_URLS=${ROOMS_TURN_URLS}
TURN_TTL=${ROOMS_TURN_TTL}

# Production env template for callService
# Copy to deploy/env/.env.production (DO NOT COMMIT real values).
# Fill every CHANGE_ME before APP_ENV=production.

# --- Shared secrets (must match across rooms / signaling / sfu / coturn) ---
ROOMS_APP_ENV=production
SIGNALING_APP_ENV=production
SFU_APP_ENV=production

ROOMS_JWT_SECRET=CHANGE_ME
ROOMS_JOIN_TOKEN_SECRET_KEY=CHANGE_ME
SIGNALING_JOIN_TOKEN_SECRET_KEY=${ROOMS_JOIN_TOKEN_SECRET_KEY}
SFU_JOIN_TOKEN_SECRET_KEY=${ROOMS_JOIN_TOKEN_SECRET_KEY}

ROOMS_SERVICE_JWT_SECRET=CHANGE_ME
SIGNALING_SERVICE_JWT_SECRET=${ROOMS_SERVICE_JWT_SECRET}
SFU_SERVICE_JWT_SECRET=${ROOMS_SERVICE_JWT_SECRET}

ROOMS_POSTGRES_PASSWORD=CHANGE_ME
ROOMS_POSTGRES_SSL_MODE=require
ROOMS_POSTGRES_HOST=postgres.example.internal
ROOMS_POSTGRES_PORT=5432
ROOMS_POSTGRES_USER=rooms_user
ROOMS_POSTGRES_DB=rooms

ROOMS_REDIS_PASSWORD=CHANGE_ME
SIGNALING_REDIS_PASSWORD=${ROOMS_REDIS_PASSWORD}
SFU_REDIS_PASSWORD=${ROOMS_REDIS_PASSWORD}
ROOMS_REDIS_HOST=redis.example.internal
SIGNALING_REDIS_HOST=redis.example.internal
SFU_REDIS_HOST=redis.example.internal

# TURN HMAC (coturn use-auth-secret = same value)
ROOMS_TURN_SHARED_SECRET=CHANGE_ME
ROOMS_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
ROOMS_TURN_TTL=1h
SFU_WEBRTC_TURN_CREDENTIAL=${ROOMS_TURN_SHARED_SECRET}

# Public URLs / ICE
SIGNALING_WS_ALLOWED_ORIGINS=https://app.example.com
SFU_WS_ALLOWED_ORIGINS=https://app.example.com
SIGNALING_WS_ALLOW_QUERY_TOKEN=false
SFU_WS_ALLOW_QUERY_TOKEN=false

SIGNALING_SFU_ENABLED=true
SIGNALING_SFU_PUBLIC_URL=wss://calls.example.com/sfu/v1/ws
SFU_PUBLIC_WS_URL=wss://calls.example.com/sfu/v1/ws
SFU_WEBRTC_NAT_1TO1_IPS=CHANGE_ME_PUBLIC_OR_LAN_IP
SFU_WEBRTC_NAT_1TO1_CANDIDATE_TYPE=host
SFU_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
SFU_WEBRTC_CLIENT_ICE_SERVERS=stun:stun.l.google.com:19302

# Kafka (external cluster, RF>=3)
CORE_KAFKA_BROKERS=kafka-1.example.internal:9092,kafka-2.example.internal:9092,kafka-3.example.internal:9092
ROOMS_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
SIGNALING_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
SFU_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}

# Metrics stay on loopback in production (code forces 127.0.0.1 when APP_ENV=production)
ROOMS_METRICS_HOST=127.0.0.1
SIGNALING_METRICS_HOST=127.0.0.1
SFU_METRICS_HOST=127.0.0.1

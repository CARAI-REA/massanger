# Example nginx edge for callService (TLS termination on the host).
# Replace calls.example, cert paths, and upstream IPs/hostnames.

upstream signaling_ws {
    server 127.0.0.1:8081;
    keepalive 32;
}

upstream sfu_ws {
    server 127.0.0.1:8082;
    keepalive 32;
}

# Rooms gRPC stays internal-only (do not expose publicly).
# signaling/sfu reach rooms:8080 on the private network with service JWT.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name calls.example;

    ssl_certificate     /etc/nginx/certs/calls.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/calls.example/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Signaling WebSocket
    location /signaling/v1/ws {
        proxy_pass http://signaling_ws/v1/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SFU WebSocket (SDP/ICE control plane)
    location /sfu/v1/ws {
        proxy_pass http://sfu_ws/v1/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Never expose Prometheus metrics on the public vhost.
    location /metrics {
        deny all;
        return 404;
    }
}

# Optional internal metrics vhost (VPN / office IP only)
server {
    listen 8443 ssl http2;
    server_name metrics.calls.internal;

    ssl_certificate     /etc/nginx/certs/calls.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/calls.example/privkey.pem;

    allow 10.0.0.0/8;
    allow 192.168.0.0/16;
    deny all;

    location /rooms/metrics {
        proxy_pass http://127.0.0.1:9090/metrics;
    }
    location /signaling/metrics {
        proxy_pass http://127.0.0.1:9091/metrics;
    }
    location /sfu/metrics {
        proxy_pass http://127.0.0.1:9093/metrics;
    }
}

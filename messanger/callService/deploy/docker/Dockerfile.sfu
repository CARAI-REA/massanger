# ============================
# Stage 1: Build SFU
# ============================
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

COPY platform/go.mod platform/go.sum ./platform/
COPY shared/go.mod shared/go.sum ./shared/
COPY sfu/go.mod sfu/go.sum ./sfu/

WORKDIR /src/sfu
RUN go mod download

WORKDIR /src
COPY platform ./platform
COPY shared ./shared
COPY sfu ./sfu

WORKDIR /src/sfu
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /sfu-service ./cmd

# ============================
# Stage 2: Runtime
# ============================
FROM alpine:3.21.3

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && apk add --no-cache ca-certificates curl

WORKDIR /app

COPY --from=builder /sfu-service ./sfu-service

USER appuser

EXPOSE 8082 9093
EXPOSE 10000-10100/udp

ENTRYPOINT ["./sfu-service"]
